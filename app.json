{
  "expo": {
    "name": "BLOOM",
    "slug": "bloom",
    "version": "0.1.0",
    "scheme": "bloom",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDF8F3",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FDF8F3"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FDF8F3"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
