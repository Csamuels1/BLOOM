{
  "name": "bloom",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "jest --runInBand",
    "test:toolchain": "node --test tests/toolchain/*.test.cjs",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "doctor": "expo-doctor",
    "check:dependencies": "expo install --check",
    "export": "expo export --platform all",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:toolchain && npm run check:dependencies"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    },
    "postcss-selector-parser": "7.1.6"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "expo": "57.0.27",
    "expo-constants": "57.0.21",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.12",
    "expo-router": "57.0.25",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "lucide-react-native": "1.52.0",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.14",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.20.4",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "3.9.9",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3"
  }
}
